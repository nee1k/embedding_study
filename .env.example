# Copy to .env and fill in. Never commit .env.

# --- Component selection --------------------------------------------------
# Fakes (default) run anywhere. Switch all three for a real measurement run.
EMBEDDER_IMPL=bagofwords        # bagofwords | minilm
CACHE_IMPL=memory               # memory | valkey
BACKEND_IMPL=echo               # echo | litellm

# --- Cache ----------------------------------------------------------------
REUSE_THRESHOLD=0.95            # cosine similarity in [-1, 1]
CACHE_TTL_S=86400               # <= 0 means no expiry
CACHE_ENABLED=true

# --- Embedding ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384               # must match the model, or FT.CREATE gets a bad DIM

# --- Valkey ---------------------------------------------------------------
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_INDEX=semcache
VALKEY_PREFIX=semcache:

# --- Backend LM: Llama 4-17B via LiteLLM on TACC Tapis --------------------
# TAPIS_BASE_URL is the OpenAI-compatible root (the path that serves
# /chat/completions).
TAPIS_BASE_URL=
TAPIS_API_KEY=
LM_MODEL=llama4-17b
LM_TEMPERATURE=0.2
LM_MAX_TOKENS=512
LM_TIMEOUT_S=120

# --- Judge: Qwen3-32B, different model family than the generator ----------
JUDGE_MODEL=qwen3-32b
JUDGE_TEMPERATURE=0.0

# --- Cost -----------------------------------------------------------------
# Tokens avoided is the primary unit; set these only if a real price exists.
USD_PER_1K_PROMPT_TOKENS=0.0
USD_PER_1K_COMPLETION_TOKENS=0.0

# --- Metrics --------------------------------------------------------------
METRICS_DB=runs/metrics.sqlite
